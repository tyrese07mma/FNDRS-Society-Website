# ─────────────────────────────────────────────────────────────────────────────
# FNDRS Society — website environment
#
# Copy to .env.local for development, and set the same values in your hosting
# provider for production. Everything here is optional: the site builds and
# runs with an empty file. Each block explains what switches on when it is set.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, without a trailing slash. Used for metadata, OpenGraph
# URLs, the sitemap and robots.txt. Set this before going live.
NEXT_PUBLIC_SITE_URL=https://fndrs-society.com

# ── Waitlist storage ─────────────────────────────────────────────────────────
# Pick ONE. Without either, /api/waitlist returns "not_configured" and the form
# tells visitors that signups are not open yet, rather than silently dropping
# the address.
#
# 1) Supabase. Run supabase/migrations/0001_waitlist.sql first. The service role
#    key is server-only — never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override the table name (defaults to waitlist_signups).
# WAITLIST_TABLE=waitlist_signups
#
# 2) Any webhook that accepts a JSON POST (Zapier, Make, n8n, a Slack hook…).
WAITLIST_WEBHOOK_URL=

# ── Contact and social ───────────────────────────────────────────────────────
# Social links render in the footer only when a URL is set, so an empty value
# can never produce a dead link.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# ── Indexing ─────────────────────────────────────────────────────────────────
# Set for preview and staging deployments so they stay out of search results.
# `npm run build:static` turns this on by default; set it to 0 for production.
NEXT_PUBLIC_NOINDEX=

# ── Analytics (all optional, nothing loads unless set) ───────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for self-hosted Plausible:
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://analytics.example.com/js/script.js
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_ID=
